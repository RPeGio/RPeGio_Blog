<script>
  import { pageviewCount } from '@waline/client/pageview'

  const el = document.querySelector<HTMLElement>('.waline-pageview-count')

  if (el) {
    try {
      pageviewCount({
        serverURL: el.dataset.server || '',
        path: el.dataset.path || window.location.pathname
      })
    } catch (error) {
      console.error('Failed to load Waline pageview:', error)
    }
  }
</script>
